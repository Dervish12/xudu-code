{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@xudu/plugin",
  "version": "1.2.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "bun test --only-failures",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "pack": "bun run script/pack.ts"
  },
  "exports": {
    ".": "./src/promise/index.ts",
    "./effect": "./src/effect/index.ts",
    "./host": "./src/host.ts",
    "./runtime": "./src/runtime.ts",
    "./tui": "./src/tui/index.ts",
    "./*": "./src/*.ts"
  },
  "imports": {
    "#plugin-source": {
      "bun": "./src/source.bun.ts",
      "node": "./src/source.node.ts",
      "default": "./src/source.node.ts"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@xudu/ai": "workspace:*",
    "@xudu/client": "workspace:*",
    "@xudu/protocol": "workspace:*",
    "@xudu/schema": "workspace:*",
    "@xudu/util": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "@xudu/theme": "workspace:*",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@xudu/theme": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@xudu/theme": "workspace:*",
    "@opentui/core": "catalog:",
    "@opentui/solid": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "electron": "44.9.1",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "@typescript/native": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dervish12/xudu-code.git",
    "directory": "packages/plugin"
  }
}
